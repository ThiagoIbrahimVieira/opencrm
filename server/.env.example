# OpenCRM — Configurações de Ambiente (Fail-Fast com Zod)
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Conexão com Supabase PostgreSQL 16
# Transaction Pooler (porta 6543) com pgbouncer=true para a aplicação em runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta / Session Mode (porta 5432) para migrations do Prisma e seed
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secrets (mínimo 32 caracteres)
JWT_ACCESS_SECRET="changeme-access-secret-32-chars-minimum-token-key"
JWT_REFRESH_SECRET="changeme-refresh-secret-32-chars-minimum-token-key"

# Criptografia LGPD de PII (AES-256-GCM requer exatamente 32 bytes = 64 hex chars)
# Gere no terminal com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Blind Index HMAC-SHA256 (requer exatamente 32 bytes = 64 hex chars)
# Gere no terminal com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PII_HMAC_KEY_HEX="abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

# Habilita contas e login rápido de demonstração (AuraCell, Sabor & Brasa, Atelier Linho)
ENABLE_DEMO_ACCOUNTS=true

# Google OAuth 2.0 / OIDC (Opcional para ambiente local/CI; se não informado, a rota /api/auth/google retorna 503)
# Deve coincidir com a mesma credencial configurada no VITE_GOOGLE_CLIENT_ID do frontend
GOOGLE_CLIENT_ID=""
