{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd server && npx prisma generate && cd .. && npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
